# ============================================
# WordPress темы (если не разрабатываете свою)
# ============================================
# wp-content/themes/twenty*
# wp-content/themes/twentytwenty*
# Раскомментируйте, если не разрабатываете свою тему

# ============================================
# Что ОСТАВИТЬ под версионным контролем:
# ============================================
# !wp-content/themes/ваша-тема/
# !wp-content/plugins/ваш-плагин/
# !wp-config-sample.php